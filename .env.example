# ───────── Server (server.ts) ─────────

# GEMINI_API_KEY: optional. Enables the AI Stylist. Without it the app uses offline advice.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: optional override (default: gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: public URL used in share links & QR codes (e.g. https://viet-phuc-remix.onrender.com).
# If unset, the server falls back to this machine's LAN IP (http://192.168.x.x:3000) so phones
# on the same Wi-Fi can scan the QR during a demo.
APP_URL="MY_APP_URL"

# PORT: optional (default 3000)
# PORT=3000

# ───────── Frontend build-time (Vite) ─────────

# VITE_PUBLIC_URL: only needed for pure static hosting without server.ts (e.g. GitHub Pages).
# VITE_PUBLIC_URL="https://your-site.example"

# VITE_FEEDBACK_URL: link to a Google Form for reporting incorrect cultural info.
# VITE_FEEDBACK_URL="https://forms.gle/xxxx"
